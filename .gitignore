# ═══════════════════════════════════════════════════════════════
# LexiFlow AI - Root .gitignore
# ═══════════════════════════════════════════════════════════════

# Node.js / Frontend
# ───────────────────────────────────────────────────────────────
node_modules/
Frontend/node_modules/
Frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Python / Backend
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
Backend/venv/
Backend/env/
Backend/ENV/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Backend uploads and temporary files
Backend/uploads/
*.tmp
*.temp

# Database files (local SQLite, if any)
# ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# Operating System
# ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editors
# ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Logs
# ───────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# Environment Variables
# ───────────────────────────────────────────────────────────────
# NOTE: Backend/.env is INTENTIONALLY TRACKED for easy sharing
# Uncomment the line below if you want to hide credentials:
# Backend/.env

# Testing
# ───────────────────────────────────────────────────────────────
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/

# Documentation builds
# ───────────────────────────────────────────────────────────────
docs/_build/

# Miscellaneous
# ───────────────────────────────────────────────────────────────
.cache
.mypy_cache/
.dmypy.json
dmypy.json

